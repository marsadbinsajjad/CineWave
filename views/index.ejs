<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CineWave - Media Tracker</title>
  <link rel="icon" type="image/png" href="/favicon.png?v=2">
  <link rel="stylesheet" href="/styles/style.css">
</head>
<body>

  <header>
    <h1>🎬 CineWave</h1>
    <p>Your Personal Movie & TV Series Tracker</p>
    
    <% if (locals.user) { %>
      <div class="user-bar">
        <span>Logged in as: <strong><%= user.name || user.email %></strong></span>
        <a href="/logout" class="btn-logout">Logout</a>
      </div>
    <% } %>

    <a href="/new" class="btn-add">+ Add Movie or Series</a>
  </header>

  <main class="books-container">
    <% if (mediaList.length === 0) { %>
      <div class="empty-msg">
        <p>Your watchlist is currently empty. Click above to add your first movie or series!</p>
      </div>
    <% } else { %>
      <div class="books-grid">
        <% mediaList.forEach(item => { %>
          <div class="book-details">
            <div class="card-header">
              <h2><%= item.title %></h2>
              <span class="badge-type"><%= item.type %></span>
            </div>

            <div class="badges-row">
              <span class="badge-category"><%= item.category %></span>
              <span class="badge-status <%= item.status === 'Watched' ? 'status-watched' : 'status-unwatched' %>">
                <%= item.status %>
              </span>
            </div>

            <div class="meta">
              <div class="rating">
                <% for(let i = 0; i < item.rating; i++) { %>★<% } %>
                <% for(let i = item.rating; i < 5; i++) { %>☆<% } %>
              </div>
            </div>

            <% if (item.notes) { %>
              <div class="notes">
                <h4>Notes</h4>
                <p><%= item.notes %></p>
              </div>
            <% } %>

            <div class="card-actions">
              <a href="/edit/<%= item.id %>" class="btn-edit">Edit</a>
              <form action="/delete/<%= item.id %>" method="POST" style="display: inline;">
                <button type="submit" class="btn-delete" onclick="return confirm('Are you sure you want to delete this item?')">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

</body>
</html>