<%- include('partials/header') %>
  <header>
    <h1>🎬 CineWave</h1>
    <p>Add a new item to your watchlist</p>
  </header>

  <div class="form-container">
    <form action="/add" method="POST" class="add-book-form">
      <h2>Add New Entry</h2>

      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" placeholder="e.g. Inception, Breaking Bad" required>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="type">Media Type</label>
          <select id="type" name="type" required>
            <option value="Movie">Movie</option>
            <option value="Series">TV Series</option>
          </select>
        </div>

        <div class="form-group">
          <label for="category">Genre</label>
          <input type="text" id="category" name="category" placeholder="e.g. Sci-Fi, Drama" required>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="status">Watch Status</label>
          <select id="status" name="status" required>
            <option value="Watched">Watched</option>
            <option value="Not Watched" selected>Not Watched</option>
          </select>
        </div>

        <div class="form-group">
          <label for="rating">Rating (1 to 5 Stars)</label>
          <select id="rating" name="rating">
            <option value="5">⭐⭐⭐⭐⭐ (5/5)</option>
            <option value="4">⭐⭐⭐⭐ (4/5)</option>
            <option value="3">⭐⭐⭐ (3/5)</option>
            <option value="2">⭐⭐ (2/5)</option>
            <option value="1">⭐ (1/5)</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="notes">Notes / Review</label>
        <textarea id="notes" name="notes" rows="3" placeholder="Add thoughts, favorite scenes, or season tracking..."></textarea>
      </div>

      <div class="form-actions">
        <a href="/" class="btn-cancel">Cancel</a>
        <button type="submit" class="btn-submit">Save Entry</button>
      </div>
    </form>
  </div>
<%- include('partials/footer') %>
</body>
</html>